{
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "noEmit": true,
    "allowJs": true,
    "module": "ESNext",
    "target": "ES2020",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "allowImportingTsExtensions": true
  },
  "include": ["./src/**/*"]
}
