  {
    "text": [
      [
        "קׇרְבָּנ֞וֹ קַֽעֲרַת־כֶּ֣סֶף אַחַ֗ת שְׁלֹשִׁ֣ים וּמֵאָה֮ מִשְׁקָלָהּ֒"
      ]
    ],
    "verses": [
      {
        "book": 4,
        "chapter": 7,
