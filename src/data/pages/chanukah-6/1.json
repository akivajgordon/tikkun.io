    "verses": [],
    "aliyot": [],
    "isPetucha": false
  },
  {
    "text": [
      [
        "שְׁנֵיהֶ֣ם ׀ מְלֵאִ֗ים סֹ֛לֶת בְּלוּלָ֥ה בַשֶּׁ֖מֶן לְמִנְחָֽה׃ כַּ֥ף"
